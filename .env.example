# Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# From-address used on all outgoing emails (must be a verified Resend domain)
MAIL_FROM=M&M Finance <contact@mnmfinance.com.au>

# Inbox that receives /contact form submissions
CONTACT_RECIPIENT=hello@mnmfinance.com.au

# Inbox that receives /get-started enquiry submissions
GETSTARTED_RECIPIENT=enquiries@mnmfinance.com.au

# Public site URL — used for links inside email templates
SITE_URL=https://mnmfinance.com.au
